<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Zeye.RfidReader.Workbench.Avalonia.Controls"
        xmlns:vm="using:Zeye.RfidReader.Workbench.Avalonia.ViewModels"
        x:Class="Zeye.RfidReader.Workbench.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640">
    <Grid Margin="24"
          ColumnDefinitions="220,*"
          RowDefinitions="Auto,Auto,*"
          ColumnSpacing="20"
          RowSpacing="16">
        <StackPanel Grid.ColumnSpan="2"
                    Spacing="6">
            <TextBlock FontSize="28"
                       FontWeight="Bold"
                       Text="{Binding Title}" />
            <TextBlock FontSize="14"
                       Opacity="0.75"
                       Text="{Binding Subtitle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Padding="16"
                CornerRadius="12"
                Background="#112C3E50">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="16">
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12">
                    <Button Content="启动读码"
                            Command="{Binding StartReadingCommand}" />
                    <Button Content="停止读码"
                            Command="{Binding StopReadingCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="12"
                Background="#0F3D4F62">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <StackPanel Margin="0,0,0,8"
                                        Spacing="4">
                                <Button HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Key}"
                                        Content="{Binding Title}"
                                        IsEnabled="{Binding IsEnabled}" />
                                <TextBlock Margin="4,0,4,0"
                                           FontSize="12"
                                           Opacity="0.72"
                                           Text="{Binding Description}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2"
              Grid.Column="1"
              RowDefinitions="*,Auto"
              RowSpacing="16">
            <Border Padding="20"
                    CornerRadius="16"
                    Background="#081D2633">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>

            <controls:RfidLottieView Grid.Row="1"
                                     Source="{Binding LottieAnimationPath}" />
        </Grid>
    </Grid>
</Window>
