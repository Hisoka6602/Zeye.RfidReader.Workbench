<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Zeye.RfidReader.Workbench.Avalonia.Controls"
        xmlns:vm="using:Zeye.RfidReader.Workbench.Avalonia.ViewModels"
        x:Class="Zeye.RfidReader.Workbench.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="960"
        Height="640"
        MinWidth="720"
        MinHeight="480">
    <Grid RowDefinitions="Auto,Auto,*" Margin="32" RowSpacing="20">
        <StackPanel Spacing="8">
            <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Title}" />
            <TextBlock FontSize="14" Opacity="0.75" Text="{Binding Subtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Padding="16" Background="#112C3E50" CornerRadius="12">
            <StackPanel Spacing="16">
                <TextBlock FontSize="14" Text="{Binding StatusText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="启动读码" Command="{Binding StartReadingCommand}" />
                    <Button Content="停止读码" Command="{Binding StopReadingCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="24">
            <controls:RfidLottieView />

            <Border Grid.Column="1" Padding="24" Background="#0F3D4F62" CornerRadius="16">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前阶段说明" />
                    <TextBlock Text="• 主窗口已接入 CommunityToolkit.Mvvm 属性通知与命令。" TextWrapping="Wrap" />
                    <TextBlock Text="• Lottie 控件已集中封装到 RfidLottieView，页面不再直接引用动画控件。" TextWrapping="Wrap" />
                    <TextBlock Text="• 后续设备客户端可在 Application 层编排后再向 UI 投递状态。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
