<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Zeye.RfidReader.Workbench.Avalonia.ViewModels"
             x:Class="Zeye.RfidReader.Workbench.Avalonia.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="12">
        <TextBlock FontSize="22"
                   FontWeight="SemiBold"
                   Text="仪表盘" />
        <ItemsControl ItemsSource="{Binding ReaderCards}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6,0,0"
                            Padding="16"
                            CornerRadius="12"
                            Background="#0F3D4F62">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding ReaderName}" />
                            <TextBlock Text="{Binding ReaderCode}" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
