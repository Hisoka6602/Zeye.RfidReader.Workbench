<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:Avalonia.Labs.Lottie;assembly=Avalonia.Labs.Lottie"
             xmlns:vm="using:Zeye.RfidReader.Workbench.Avalonia.ViewModels"
             x:Class="Zeye.RfidReader.Workbench.Avalonia.Controls.RfidLottieView"
             x:DataType="vm:MainWindowViewModel">
    <Border Padding="24" Background="#0F3D4F62" CornerRadius="16">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <lottie:Lottie Width="280"
                           Height="280"
                           AutoPlay="True"
                           RepeatCount="-1"
                           Path="{Binding LottieAnimationPath}" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="RFID 动画占位" />
        </StackPanel>
    </Border>
</UserControl>
